#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

void calcularBhaskara(double a ,double b, double c){

    double delta = b*b - 4*a*c;


    if((a==0) || (delta<0)){
        cout<<"Impossivel calcular\n";
    }else{
        double r1= (-b + sqrt(delta)) / (2 * a);
    
        double r2= (-b - sqrt(delta)) / (2 * a);
    
        cout<<fixed<<setprecision(5);
    
        cout<<"R1 = "<<r1<<endl;
        cout<<"R2 = "<<r2<<endl;

    }

}

int main(){
    
    double a,b,c;
    
    cin>>a>>b>>c;

    calcularBhaskara(a,b,c);
     
    return 0 ;
}
